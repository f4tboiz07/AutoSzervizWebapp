@page
@model AutoSzervizWebapp.Pages.JavitasPages.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Javitas</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Javitas.Rendszam" class="control-label"></label>
                <input asp-for="Javitas.Rendszam" class="form-control" aria-required="true"/>
                <span asp-validation-for="Javitas.Rendszam" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Javitas.Leiras" class="control-label"></label>
                <input asp-for="Javitas.Leiras" class="form-control" />
                <span asp-validation-for="Javitas.Leiras" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Javitas.Koltseg" class="control-label"></label>
                <input asp-for="Javitas.Koltseg" class="form-control" />
                <span asp-validation-for="Javitas.Koltseg" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <label asp-for="AllapotIndex" class="control-label"> Javítás állapota</label>
                <input asp-for="AllapotIndex"
                    type="range"
                    min="0"
                    max="2"
                    step="1"
                    class="form-range"
                       oninput="document.getElementById('allapotSzoveg').textContent =
                       ['Felvéve', 'Folyamatban', 'Kész'][this.value]"      
                />
@*                 <span asp-validation-for="Javitas.Allapot" class="text-danger"></span>*@
                <div class="d-flex justify-content-between" >
                    <small>Felvéve</small>
                    <small>Folyamatban</small>
                    <small>Kész</small>
                </div>
                <p class="mt-2">
                    Kiválasztott Állapot:
                    <strong id="allapotSzoveg">
                        @(Model.AllapotIndex switch
                        {
                            0 => "Felvéve",
                            1 => "Folyamatban",
                            2 => "Kész",
                            _ => "Folyamatban"
                        })
                    </strong>
                </p>
                
                <span asp-validation-for="AllapotIndex" class="text-danger"></span>
         </div>
            <div class="form-group">
                <label asp-for="Javitas.FelvetelDatuma" class="control-label"></label>
                <input asp-for="Javitas.FelvetelDatuma" class="form-control" />
                <span asp-validation-for="Javitas.FelvetelDatuma" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
